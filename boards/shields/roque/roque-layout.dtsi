
#include <physical_layouts.dtsi>
#include "position_map.dtsi"

/ {
    roque_layout: roque_layout {
        compatible = "zmk,physical-layout";
        display-name = "Roque";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0  (-800)   285   285>
