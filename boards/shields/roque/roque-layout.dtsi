            , <&key_physical_attrs 100 100 1200  105       0     0     0>
            , <&key_physical_attrs 100 100 1300  105       0     0     0>
            , <&key_physical_attrs 100 100 1400  105     400  1300   285>
            , <&key_physical_attrs 100 100 1500  105     800  1380   285>
            , <&key_physical_attrs 100 100    0  200  (-800)   285   285>
            , <&key_physical_attrs 100 100  100  205  (-400)   350   275>
